import os
import json
import time
import subprocess
import argparse

# ================= 1. 核心路径与扫描配置 =================
# 调用的子船脚本路径
SLICER_SCRIPT = "rag_audio_slicer.py"
# 断点续传账本路径 (记录已处理的文件指纹)
PROGRESS_LOG = "processed_files.json"

# 支持的音频格式
SUPPORTED_EXTENSIONS = ('.mp3', '.m4a', '.wav', '.flac', '.aac')

# ================= 2. Fast Hash 指纹引擎 =================
def get_file_fingerprint(filepath):
    """
    通过文件名、大小、最后修改时间生成极速指纹。
    无需读取大文件内容，秒级生成，且能精准识别文件是否被替换或修改。
    """
    try:
        stat = os.stat(filepath)
        return f"{os.path.basename(filepath)}|{stat.st_size}|{stat.st_mtime}"
    except Exception as e:
        print(f"⚠️ 无法获取指纹: {filepath}, 错误: {e}")
        return None

def load_progress():
    if os.path.exists(PROGRESS_LOG):
        with open(PROGRESS_LOG, 'r', encoding='utf-8') as f:
            try: return json.load(f)
            except: return {}
    return {}

def save_progress(progress_data):
    with open(PROGRESS_LOG, 'w', encoding='utf-8') as f:
        json.dump(progress_data, f, ensure_ascii=False, indent=4)

# ================= 3. 自动化流水线调度引擎 =================
def main():
    # 🌟 新增：解析命令行输入的文件夹路径
    parser = argparse.ArgumentParser(description="🚀 祷告塔 AI 批量处理母舰")
    parser.add_argument("input_dir", type=str, help="必须提供: 要扫描的音频文件夹完整路径 (例如 /mnt/z/祷告塔源文件)")
    args = parser.parse_args()
    
    INPUT_BASE_DIR = args.input_dir
    
    if not os.path.exists(INPUT_BASE_DIR):
        print(f"❌ 找不到指定的文件夹: {INPUT_BASE_DIR}")
        return

    print("🚀 祷告塔 AI 批量处理母舰已启动...")
    progress = load_progress()
    processed_count = 0
    skipped_count = 0

    # 递归扫描所有子文件夹
    all_files = []
    for root, dirs, files in os.walk(INPUT_BASE_DIR):
        for file in files:
            if file.lower().endswith(SUPPORTED_EXTENSIONS):
                all_files.append(os.path.join(root, file))

    print(f"📂 扫描完成：共发现 {len(all_files)} 个音频文件。")

    for filepath in all_files:
        fingerprint = get_file_fingerprint(filepath)
        if not fingerprint:
            continue

        # --- 🛡️ 断点续传逻辑 ---
        # 如果指纹存在于账本中，说明该文件已处理且未被修改，直接跳过
        if progress.get(filepath) == fingerprint:
            skipped_count += 1
            continue

        print("\n" + "="*60)
        print(f"📦 正在处理 [{processed_count + 1}]: {os.path.basename(filepath)}")
        print(f"📍 路径: {filepath}")
        print("="*60)

        # --- 唤醒子船：启动单文件切片脚本 ---
        # 使用 subprocess 确保子脚本即便崩溃，母舰也能继续处理下一个文件
        try:
            # 🌟 修改点：这里的 python3 已修改为 python，确保调用 conda 虚拟环境
            cmd = ["python", SLICER_SCRIPT, filepath]
            result = subprocess.run(cmd)

            if result.returncode == 0:
                # 处理成功，更新账本
                progress[filepath] = fingerprint
                save_progress(progress)
                processed_count += 1
                print(f"✅ 处理完成: {os.path.basename(filepath)}")
            else:
                print(f"❌ 子程序报错: {os.path.basename(filepath)}，跳过并处理下一个。")

        except Exception as e:
            print(f"⚠️ 母舰调度异常: {e}")

    print("\n" + "="*45)
    print(" 🏁 批量任务处理结束报告")
    print("="*45)
    print(f" 🆕 本次成功处理文件 : {processed_count} 个")
    print(f" ⏭️ 跳过已处理文件   : {skipped_count} 个")
    print(f" 📊 账本记录总数     : {len(progress)} 条")
    print("="*45)
    print("🎉 任务圆满完成！")

if __name__ == "__main__":
    main()
